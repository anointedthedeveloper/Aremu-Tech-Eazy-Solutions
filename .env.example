# --- Database (MongoDB Atlas free tier works) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=aremutech

# --- Sessions: any long random string (32+ chars) ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# --- Admin login (page: /lgad). Set ADMIN_PASSWORD_HASH (preferred) or ADMIN_PASSWORD. ---
ADMIN_EMAIL=aremutecheazysolutions@gmail.com
# create a hash with:  npm run hash-password -- "your password"
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# --- Email (applicant login emails + admin notifications). Gmail: use an App Password. ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=aremutecheazysolutions@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Aremu Tech Eazy Solutions <aremutecheazysolutions@gmail.com>"
# where "new application / enquiry" alerts go (defaults to ADMIN_EMAIL)
ADMIN_NOTIFY_EMAIL=

# --- Public site address (used in emails) ---
SITE_URL=https://aremutecheazysolutions.com

# --- Frontend origin (only needed when frontend and backend are on different domains) ---
# Set this to the TrueHost domain so the CORS + CSRF checks allow it.
# Example: ALLOWED_ORIGIN=https://aremutecheazysolutions.com
ALLOWED_ORIGIN=https://aremutecheazysolutions.com

# --- Frontend → backend URL (Vite build-time var, set when building the frontend) ---
# Point this at your Vercel deployment so the browser knows where to send API calls.
# Example: VITE_API_URL=https://aremu-tech.vercel.app
VITE_API_URL=https://aremu-tech.vercel.app
