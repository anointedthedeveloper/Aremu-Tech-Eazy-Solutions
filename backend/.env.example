# ---------------------------------------------------------------
# Copy this file to .env and fill in the values before deploying.
# On Vercel, set these in Project Settings → Environment Variables.
# ---------------------------------------------------------------

# --- Database (MongoDB Atlas free tier works) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=aremutech

# --- Sessions: any long random string (32+ chars) ---
# Vercel can auto-generate this — leave blank and tick "Generate" in the dashboard.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# --- Admin login (admin page: /lgad on the frontend) ---
ADMIN_EMAIL=aremutecheazysolutions@gmail.com
# Generate a hash with: npm run hash-password -- "your password"
ADMIN_PASSWORD_HASH=
# Plain-text fallback (only for local dev, never use in production)
ADMIN_PASSWORD=

# --- Email (applicant login emails + admin notifications) ---
# Gmail: create a 16-character App Password in your Google Account security settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=aremutecheazysolutions@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Aremu Tech Eazy Solutions <aremutecheazysolutions@gmail.com>"
# Where "new application / enquiry" alerts go (defaults to ADMIN_EMAIL if blank)
ADMIN_NOTIFY_EMAIL=

# --- URLs ---
# Public address of the FRONTEND (used in email links sent to applicants)
SITE_URL=https://aremutecheazysolutions.com

# Frontend origin allowed to call this API (CORS + CSRF protection)
# Must match the exact origin of your TrueHost site (no trailing slash)
ALLOWED_ORIGIN=https://aremutecheazysolutions.com
